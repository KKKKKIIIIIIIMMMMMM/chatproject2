# Copy this file to .env (already ignored by Git), then add your own key.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# OpenRouter requires an API key. The free example model may be rate-limited;
# choose another model slug if desired and check its current pricing first.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# If Neo4j runs on a different port or uses another password, add these:
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_password_here
# NEO4J_PROJECT_ID=fitness_rag_final_2026

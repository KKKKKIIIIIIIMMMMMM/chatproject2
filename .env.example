# Copy this file to .env (already ignored by Git), then add your own keys.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_MODEL is the default for CLI. The web UI has its own model selector.

# OpenRouter is optional. Its free example model may be rate-limited.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# LINE Messaging API credentials (never put real values in this example file).
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Optional LINE bot settings (defaults shown):
# LINE_PROVIDER=auto
# LINE_LOCAL_MODEL=qwen3.5:9b-q4_K_M
# LINE_RETRIEVAL_MODE=auto
# LINE_TOP_K=4
# LINE_PORT=8000
# If you run a persistent HTTPS endpoint manually, set its origin (no /webhook).
# The one-click launcher discovers the current tunnel URL automatically.
# LINE_PUBLIC_BASE_URL=https://your-domain.example

# If Neo4j runs on a different port or uses another password, add these:
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_password_here
# NEO4J_PROJECT_ID=fitness_rag_final_2026
